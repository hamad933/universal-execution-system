{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-execution-system.invalid/protocol/checkpoint.schema.json",
  "title": "Execution Checkpoint",
  "type": "object",
  "required": ["schema_version", "project", "workstream_id", "repository", "ref", "confirmed_head_sha", "stage", "next_action"],
  "properties": {
    "schema_version": {"type": "string"},
    "project": {"type": "string"},
    "workstream_id": {"type": "string"},
    "repository": {"type": "string"},
    "ref": {"type": "string"},
    "confirmed_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "base_sha": {"type": ["string", "null"]},
    "operation_id": {"type": ["string", "null"]},
    "write_outcome": {"enum": ["NONE", "CONFIRMED", "UNKNOWN"]},
    "stage": {"type": "string"},
    "ci_runs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "unfinished_work": {"type": "array", "items": {"type": "string"}},
    "prohibitions": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
