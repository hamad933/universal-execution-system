{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-execution-system.invalid/protocol/write-request.schema.json",
  "title": "UES Bounded Write Request",
  "type": "object",
  "required": ["schema_version", "command", "sha", "ref", "paths"],
  "properties": {
    "schema_version": {"type": "string"},
    "command": {"const": "format-fix"},
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "ref": {"type": "string", "minLength": 1},
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "formatter": {"enum": ["prettier-pinned"]},
    "max_paths": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
