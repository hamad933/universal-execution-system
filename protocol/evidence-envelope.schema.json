{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-execution-system.invalid/protocol/evidence-envelope.schema.json",
  "title": "Execution Evidence Envelope",
  "type": "object",
  "required": ["schema_version", "repository", "workstream_id", "operation_id", "start_sha", "state"],
  "properties": {
    "schema_version": {"type": "string"},
    "repository": {"type": "string"},
    "workstream_id": {"type": "string"},
    "operation_id": {"type": "string"},
    "branch": {"type": "string"},
    "base_sha": {"type": "string"},
    "start_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "start_tree_sha": {"type": "string"},
    "final_sha": {"type": ["string", "null"]},
    "final_tree_sha": {"type": ["string", "null"]},
    "rollback_sha": {"type": ["string", "null"]},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "ci_runs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "failure_classifications": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "state": {"enum": ["READY", "PREFLIGHTED", "MUTATING", "LOCAL_VERIFIED", "COMMITTED", "PUSHED", "CI_PENDING", "CI_COMPLETE", "HANDOFF_READY", "CLOSED", "BLOCKED", "UNKNOWN_WRITE_OUTCOME"]},
    "environment_fingerprint": {"type": "object", "additionalProperties": true},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
