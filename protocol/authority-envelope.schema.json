{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-execution-system.invalid/protocol/authority-envelope.schema.json",
  "title": "Execution Authority Envelope",
  "type": "object",
  "required": ["schema_version", "operation_id", "workstream_id", "repository", "ref", "expected_head_sha", "operation", "allowed_paths", "stop_gate"],
  "properties": {
    "schema_version": {"type": "string"},
    "operation_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string"},
    "repository": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "expected_tree_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "operation": {"type": "string", "minLength": 1},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "prohibited_paths": {"type": "array", "items": {"type": "string"}},
    "resource_classes": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": "string"},
    "stop_gate": {"type": "string", "minLength": 1},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
