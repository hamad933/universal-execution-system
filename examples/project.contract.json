{
  "schema_version": "0.1",
  "project": {
    "id": "UES",
    "name": "Universal Execution System"
  },
  "repository": {
    "provider": "github",
    "full_name": "hamad933/universal-execution-system",
    "default_branch": "main"
  },
  "adapter": {
    "family": "python",
    "capabilities": ["python"],
    "commands": {
      "detect": ["python", "-m", "ues.cli", "detect", "--repo", "."],
      "test-fast": ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
    }
  },
  "policy": {
    "privileged_paths": [".github/workflows/**", "protocol/**"],
    "protected_paths": [],
    "resource_mode": "lean"
  },
  "extensions": {}
}
